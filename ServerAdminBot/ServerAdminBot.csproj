<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.2.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Tests" />
    <PackageReference Include="DSharpPlus" Version="4.5.3" />
    <PackageReference Include="DSharpPlus.SlashCommands" Version="4.5.3" />
    <PackageReference Include="Npgsql" Version="8.0.9" />
    <Compile Include="../Shared/ApiProtocol.cs" Link="Components/ApiProtocol.cs" />
    <Compile Include="../Shared/ApiModels.cs" Link="Components/ApiModels.cs" />
    <EmbeddedResource Include="Database/Schema.sql" />
  </ItemGroup>
</Project>
